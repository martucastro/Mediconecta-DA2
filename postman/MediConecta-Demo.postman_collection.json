      "item": [
        {
          "name": "Registrar Paciente B",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () {",
                  "    pm.expect([200,201]).to.include(pm.response.code);",
                  "});"
