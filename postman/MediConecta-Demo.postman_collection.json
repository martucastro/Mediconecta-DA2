          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{pacienteB_nombre}}\",\n  \"email\": \"{{pacienteB_email}}\",\n  \"rol\": \"PACIENTE\",\n  \"contrasena\": \"{{pacienteB_password}}\"\n}"
