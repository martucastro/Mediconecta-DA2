# Configuracion de WildFly para MediConecta.
#
# Deja el servidor listo para recibir el WAR: instala el driver de PostgreSQL,
# crea el datasource java:/MediConectaDS, habilita la integracion de Jakarta
# Security con Elytron, crea el topico JMS TurnoConfirmadoTopic y la cola
# ReclamosFacturacionQueue con su politica de reintentos (requiere haber
# arrancado con standalone-full.xml).
#
# Uso, con WildFly YA CORRIENDO y el driver descargado (ver README):
#
#   jboss-cli.bat --connect --file=deploy/mediconecta-setup.cli
#
# Es idempotente: si algo ya existe, ese paso se saltea en vez de fallar.

# ---------------------------------------------------------------------------
# 1. Driver JDBC de PostgreSQL como modulo de WildFly
# ---------------------------------------------------------------------------
if (outcome != success) of /subsystem=datasources/jdbc-driver=postgresql:read-resource
    module add --name=org.postgresql \
               --resources=deploy/postgresql.jar \
               --dependencies=java.se,jakarta.transaction.api

    /subsystem=datasources/jdbc-driver=postgresql:add( \
        driver-name=postgresql, \
        driver-module-name=org.postgresql, \
        driver-xa-datasource-class-name=org.postgresql.xa.PGXADataSource)
end-if

# ---------------------------------------------------------------------------
# 2. Datasource java:/MediConectaDS
#
# El nombre JNDI tiene que coincidir exactamente con el <jta-data-source> de
# src/main/resources/META-INF/persistence.xml.
# ---------------------------------------------------------------------------
if (outcome != success) of /subsystem=datasources/data-source=MediConectaDS:read-resource
    data-source add --name=MediConectaDS \
        --jndi-name=java:/MediConectaDS \
        --driver-name=postgresql \
        --connection-url=jdbc:postgresql://localhost:5432/mediconecta \
        --user-name=postgres \
        --password=postgres \
        --use-ccm=true \
        --background-validation=true \
        --valid-connection-checker-class-name=org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLValidConnectionChecker \
        --exception-sorter-class-name=org.jboss.jca.adapters.jdbc.extensions.postgres.PostgreSQLExceptionSorter
end-if

# ---------------------------------------------------------------------------
# 3. Integracion de Jakarta Security con Elytron
#
# ESTE PASO NO ES OPCIONAL Y NO ES OBVIO.
#
# La autenticacion del sistema usa Jakarta Security (Soteria) con
# @BasicAuthenticationMechanismDefinition y @DatabaseIdentityStoreDefinition,
# declarados en usuarios/presentacion/ConfiguracionDeSeguridad.java.
#
# Con la configuracion por defecto de WildFly, Elytron intenta autorizar contra
# su propio realm la identidad que establecio Soteria, no la encuentra, y TODOS
# los endpoints responden 500 con "ELY01177: Authorization failed".
#
# El sintoma que delata el problema: una credencial incorrecta devuelve 401
# (la autenticacion funciona) y una credencial correcta devuelve 500.
# ---------------------------------------------------------------------------
/subsystem=undertow/application-security-domain=other:write-attribute( \
    name=integrated-jaspi, value=false)

# ---------------------------------------------------------------------------
# 4. Topico JMS TurnoConfirmadoTopic
#
# Al confirmarse un turno se publica un evento TurnoConfirmado en este topico y
# ServicioDeNotificaciones (@MessageDriven) lo consume de forma asincronica.
# Aca solo se crea el destino; publicador y consumidor van en otra entrega.
#
# El JNDI java:/jms/topic/TurnoConfirmado es un contrato con el codigo: el
# publicador y el consumidor lo van a buscar con este nombre exacto.
#
# Requiere haber arrancado con standalone-full.xml: el perfil por defecto no
# trae el subsistema messaging-activemq y este paso falla con WFLYCTL0030 ("No
# resource definition is registered"). En ese caso, reiniciar con
# standalone-full.xml y volver a correr el script.
# ---------------------------------------------------------------------------
if (outcome != success) of /subsystem=messaging-activemq/server=default/jms-topic=TurnoConfirmadoTopic:read-resource
    /subsystem=messaging-activemq/server=default/jms-topic=TurnoConfirmadoTopic:add( \
        entries=["java:/jms/topic/TurnoConfirmado"])
end-if

# ---------------------------------------------------------------------------
# 5. Cola JMS ReclamosFacturacionQueue
#
# Cada reclamo de facturacion a la obra social lo procesa exactamente UN
# consumidor (el @MessageDriven de ServicioDeFacturacion), por eso es una cola
# punto a punto y no un topico como TurnoConfirmado, que puede tener varios
# interesados a la vez.
#
# El JNDI java:/jms/queue/ReclamosFacturacion es un contrato con el codigo.
#
# Un reclamo que falla siempre no puede reintentarse para siempre: despues de
# 5 entregas fallidas Artemis lo mueve a ReclamosFacturacionDLQ, una cola de
# mensajes no entregados propia de facturacion. Asi los reclamos trabados no
# se mezclan con los de otros destinos en la DLQ general y se pueden revisar
# o reenviar a mano. Entre reintentos espera 2 s, 4 s, 8 s... hasta 30 s, para
# darle tiempo a la obra social a volver si estaba caida.
# ---------------------------------------------------------------------------
if (outcome != success) of /subsystem=messaging-activemq/server=default/jms-queue=ReclamosFacturacionDLQ:read-resource
    /subsystem=messaging-activemq/server=default/jms-queue=ReclamosFacturacionDLQ:add( \
        entries=["java:/jms/queue/ReclamosFacturacionDLQ"])
end-if

if (outcome != success) of /subsystem=messaging-activemq/server=default/jms-queue=ReclamosFacturacionQueue:read-resource
    /subsystem=messaging-activemq/server=default/jms-queue=ReclamosFacturacionQueue:add( \
        entries=["java:/jms/queue/ReclamosFacturacion"])
end-if

if (outcome != success) of /subsystem=messaging-activemq/server=default/address-setting=jms.queue.ReclamosFacturacionQueue:read-resource
    /subsystem=messaging-activemq/server=default/address-setting=jms.queue.ReclamosFacturacionQueue:add( \
        dead-letter-address=jms.queue.ReclamosFacturacionDLQ, \
        max-delivery-attempts=5, \
        redelivery-delay=2000, \
        redelivery-multiplier=2.0, \
        max-redelivery-delay=30000)
end-if

# ---------------------------------------------------------------------------
# 6. Aplicar
# ---------------------------------------------------------------------------
reload
