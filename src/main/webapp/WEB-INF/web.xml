<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <!--
      Sistema legado de la obra social (simulado). Se mapea a mano para que la
      URL del WSDL sea estable: /mediconecta/legado/obrasocial?wsdl.
      No lleva security-constraint a proposito: representa a un tercero, que
      no conoce a los usuarios de MediConecta ni su autenticacion.
    -->
    <servlet>
        <servlet-name>ObraSocialLegado</servlet-name>
        <servlet-class>ar.edu.uade.da2.mediconecta.externos.obrasocial.ObraSocialLegado</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ObraSocialLegado</servlet-name>
        <url-pattern>/legado/obrasocial</url-pattern>
    </servlet-mapping>

    <security-role>
        <role-name>ADMINISTRADOR</role-name>
    </security-role>
    <security-role>
        <role-name>PACIENTE</role-name>
    </security-role>
    <security-role>
        <role-name>PROFESIONAL</role-name>
    </security-role>

    <!--
      Operacion sensible 1: la historia clinica completa. El TP la marca como
      dato de alta sensibilidad, asi que ninguna de sus operaciones es anonima.
      Quien puede leer y quien puede escribir lo decide @RolesAllowed sobre la
      fachada del componente; aca solo se exige estar autenticado.
    -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Historia clinica</web-resource-name>
            <url-pattern>/api/historias/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>PROFESIONAL</role-name>
            <role-name>PACIENTE</role-name>
            <role-name>ADMINISTRADOR</role-name>
        </auth-constraint>
    </security-constraint>

    <!--
      Operacion sensible 2: el listado completo de usuarios es solo del
      administrador. Se restringe unicamente el GET, porque el POST sobre la
      misma URL es el registro publico: si lo cerraramos no habria forma de
      crear el primer usuario del sistema.
    -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Listado de usuarios</web-resource-name>
            <url-pattern>/api/usuarios</url-pattern>
            <http-method>GET</http-method>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMINISTRADOR</role-name>
        </auth-constraint>
    </security-constraint>

    <!--
      Operacion sensible 3: reservar, confirmar y cancelar turnos. Se exige
      estar autenticado para todo lo que no sea consultar disponibilidad: el
      paciente sobre el que se opera se resuelve del caller principal, nunca de
      un parametro, asi que sin autenticacion no hay a nombre de quien reservar.
      Quien puede hacer que lo decide @RolesAllowed sobre ServicioDeTurnos.
    -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Gestion de turnos</web-resource-name>
            <url-pattern>/api/turnos/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>PACIENTE</role-name>
            <role-name>PROFESIONAL</role-name>
            <role-name>ADMINISTRADOR</role-name>
        </auth-constraint>
    </security-constraint>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Reserva de turnos</web-resource-name>
            <url-pattern>/api/turnos</url-pattern>
            <http-method>POST</http-method>
        </web-resource-collection>
        <auth-constraint>
            <role-name>PACIENTE</role-name>
        </auth-constraint>
    </security-constraint>

    <!--
      Operacion sensible 4: los pagos. Mueven dinero, asi que ninguna operacion
      es anonima. Quien puede cobrar, consultar o reembolsar lo decide
      @RolesAllowed sobre ServicioDePagos; aca solo se exige estar autenticado.
    -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Pagos</web-resource-name>
            <url-pattern>/api/pagos/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>PACIENTE</role-name>
            <role-name>PROFESIONAL</role-name>
            <role-name>ADMINISTRADOR</role-name>
        </auth-constraint>
    </security-constraint>

    <!--
      Operacion sensible 5: el listado de reclamos de facturacion es solo del
      administrador (visibilidad de la demo, ver docs/documento-tecnico.md).
      Quien puede operar sobre un reclamo puntual lo decide @RolesAllowed
      sobre ServicioDeFacturacion; aca se restringe toda la URL porque hoy la
      unica operacion expuesta es el listado completo.
    -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Reclamos de facturacion</web-resource-name>
            <url-pattern>/api/reclamos</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMINISTRADOR</role-name>
        </auth-constraint>
    </security-constraint>

    <!--
      Operacion sensible 6: las notificaciones del paciente. Solo el PACIENTE
      las consulta (GET /api/notificaciones/mias): se generan para el paciente
      del turno confirmado y el usuario sale del caller principal, nunca de un
      parametro. Un profesional o un administrador reciben 403, y sin
      autenticacion la respuesta es 401 en vez de un 500 por no haber caller.
    -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Notificaciones</web-resource-name>
            <url-pattern>/api/notificaciones/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>PACIENTE</role-name>
        </auth-constraint>
    </security-constraint>

    <!--
      Operacion sensible 7: la sala de video de un turno. Quien tiene el enlace
      entra a la consulta, asi que nunca es anonima. Incluye al administrador
      para que reciba 403 desde el componente (y no 401 o un rechazo distinto
      de la capa web): que la sala sea solo del paciente y del profesional del
      turno lo decide ServicioDeTelemedicina.
    -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Telemedicina</web-resource-name>
            <url-pattern>/api/telemedicina/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>PACIENTE</role-name>
            <role-name>PROFESIONAL</role-name>
            <role-name>ADMINISTRADOR</role-name>
        </auth-constraint>
    </security-constraint>

    <!--
      Fallback del frontend: cualquier URL que no corresponda a un archivo ni a
      la API devuelve index.html. El frontend es una SPA y sus rutas (por
      ejemplo /mediconecta/agenda) no existen como archivos en el servidor:
      sin esto, refrescar el navegador en una pantalla daria el 404 del
      contenedor. Una URL que tampoco sea una pantalla la resuelve el router
      del frontend con su propia pagina 404.

      Los 404 de la API no pasan por aca: JAX-RS escribe la respuesta
      directamente, asi que el cliente sigue recibiendo su mensaje de error y
      no el HTML de la aplicacion.
    -->
    <error-page>
        <error-code>404</error-code>
        <location>/index.html</location>
    </error-page>

</web-app>